#Hacemos un stack de las bases
df_1v <- rbind.data.frame(boric,boric_2V,meo,sichel,yasna)
#Construir el corups de texto
df_1v <-  df_1v %>%  filter(ad_creative_bodies !="NA")
#creamos un corpus para df_1v
corpus_df_1v <- df_1v$ad_creative_bodies %>%  corpus()
#Identificador
docvars(corpus_df_1v)$id <- seq.int(length(docvars(corpus_df_1v)$n))
#Añadimos ariables de la base de datos al corpus de texto
docvars(corpus_df_1v) <- df_1v
#Tokenizaamos
tokens_df_1v <- tokens(corpus_df_1v)
## Decisiones de pre-processing
#Removemos puntos y numeros
tokens_df_1v <- tokens(tokens_df_1v, remove_punct = T, remove_numbers = T)
#Solo minusculas (decapitalization)
tokens_df_1v <- tokens_tolower(tokens_df_1v)
#Stopwords en español
tokens_df_1v <- tokens_select(tokens_df_1v, pattern = stopwords("es"),  selection = "remove")
tokens_df_1v
#removewords
tokens_df_1v <- tokens_remove(tokens_df_1v, pattern = c("sichel", "boric", "yasna", "marco", "ahorayasna", "vota*"), padding = TRUE)
print(tokens_df_1v)
#ngrams
tokens_df_1v <- tokens_ngrams(tokens_df_1v,n = 1)
#Doc Feature Matrix
df_1v_dfm <-dfm(tokens_df_1v)
#Topfeatures
topfeatures(df_1v_dfm, 100)
#removewords
tokens_df_1v <- tokens_remove(tokens_df_1v, pattern = c("sichel", "boric", "yasna", "marco", "#ahorayasna", "vota*"), padding = TRUE)
print(tokens_df_1v)
#Topfeatures
topfeatures(df_1v_dfm, 100)
